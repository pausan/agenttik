bin/
*.db
*.db-shm
*.db-wal

# The UI is built into web/dist by `make ui`; only the placeholder that keeps
# the embed directive valid is tracked.
node_modules/
web/dist/*
!web/dist/.gitkeep

# Regenerated by the Nuxt UI vite plugin on every build.
auto-imports.d.ts
components.d.ts

# Playwright output.
e2e/test-results/
e2e/playwright-report/
tmp-*
# The screen encoder library is built by `make vpx` (scripts/build-vpx.sh);
# only the placeholders that keep the embed directives valid are tracked.
app/internal/screen/vpx/lib/*/*
!app/internal/screen/vpx/lib/*/.gitkeep

# Native Whisper helper, built by make speech.
!app/internal/speech/bin/
app/internal/speech/bin/*
!app/internal/speech/bin/README.txt
!app/internal/speech/bin/LICENSE.whisper
